# Optional. Leaflet + OSM tiles are used by default (no key required).
# Swap GraphRoutingEngine for Mapbox Directions by implementing RoutingEngine.
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_TOKEN=

# Production Postgres + PostGIS. Unused in the in-memory MVP.
DATABASE_URL=postgres://voltgrid:voltgrid@localhost:5432/voltgrid

# Public site URL for local preview
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123
