# Optional routing provider token placeholders. Keep real secrets out of source control.
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_TOKEN=

# Optional production Postgres/PostGIS connection. Do not commit real credentials.
DATABASE_URL=

# Public origin used by the explicit CORS allow-list.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Open Charge Map token. Never prefix with NEXT_PUBLIC_.
OCM_API_KEY=
