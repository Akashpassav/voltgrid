# Optional routing provider token placeholders. Keep real secrets out of source control.
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_TOKEN=

# Optional production Postgres/PostGIS connection. Do not commit real credentials.
DATABASE_URL=

# Public origin used by the explicit CORS allow-list.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 only when this process sits behind a trusted reverse proxy.
# Enables X-Forwarded-For / X-Real-IP for rate-limit keys. Leave unset locally.
TRUST_PROXY=

# Server-only Open Charge Map token. Never prefix with NEXT_PUBLIC_.
OCM_API_KEY=

# ── RAZORPAY CONFIGURATION ──────────────────────────────────────────
# NOTE: Replace with live keys (rzp_live_...) before deploying to production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_VoltGridDemoKey
RAZORPAY_KEY_SECRET=VoltGridSecretDemoTestKey123
